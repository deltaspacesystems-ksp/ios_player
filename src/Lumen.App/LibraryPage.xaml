<Page x:Class="Lumen.App.LibraryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:Lumen.App"
      NavigationCacheMode="Required">
    <Page.Resources>
        <DataTemplate x:Key="TrackTemplate" x:DataType="local:TrackVM">
            <Grid Height="54" ColumnSpacing="14" Padding="4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/>
                </Grid.ColumnDefinitions>
                <Border Width="42" Height="42" CornerRadius="6" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                    <Image Source="{x:Bind Art, Mode=OneWay}" Stretch="UniformToFill"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{x:Bind Artist}" FontSize="12" Opacity="0.65" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{x:Bind Album}" VerticalAlignment="Center" Opacity="0.65" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="3" Text="{x:Bind DurationText}" VerticalAlignment="Center" HorizontalAlignment="Right" Opacity="0.65"/>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="GroupTemplate" x:DataType="local:GroupVM">
            <StackPanel Width="170" Spacing="6" Padding="4">
                <Border Width="162" Height="162" CornerRadius="12" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                    <Image Source="{x:Bind Art, Mode=OneWay}" Stretch="UniformToFill"/>
                </Border>
                <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
                <TextBlock Text="{x:Bind Subtitle}" FontSize="12" Opacity="0.65" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="28,12,28,0" RowSpacing="10">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <Grid>
            <TextBlock Text="Library" FontSize="30" FontWeight="SemiBold"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" VerticalAlignment="Center">
                <TextBlock x:Name="ScanText" VerticalAlignment="Center" Opacity="0.7" FontSize="12"/>
                <ProgressRing x:Name="ScanRing" Width="18" Height="18" IsActive="False"/>
                <Button Click="AddFolder_Click"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8F4;" FontSize="14"/><TextBlock Text="Add folder"/></StackPanel></Button>
                <Button Click="Rescan_Click" ToolTipService.ToolTip="Rescan"><FontIcon Glyph="&#xE72C;" FontSize="14"/></Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <SelectorBar x:Name="Modes" SelectionChanged="Modes_SelectionChanged">
                <SelectorBarItem Text="Tracks" IsSelected="True"/>
                <SelectorBarItem Text="Albums"/>
                <SelectorBarItem Text="Artists"/>
                <SelectorBarItem Text="Genres"/>
            </SelectorBar>
            <StackPanel Grid.Column="1" x:Name="FilterChip" Orientation="Horizontal" Spacing="6" Visibility="Collapsed" VerticalAlignment="Center">
                <Button Click="ClearFilter_Click" Padding="10,2"><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock x:Name="FilterText"/><FontIcon Glyph="&#xE711;" FontSize="10"/></StackPanel></Button>
            </StackPanel>
            <AutoSuggestBox x:Name="Search" Grid.Column="2" Width="280" PlaceholderText="Search library" QueryIcon="Find"
                            TextChanged="Search_TextChanged"/>
        </Grid>

        <Grid Grid.Row="2">
            <ListView x:Name="TrackList" ItemTemplate="{StaticResource TrackTemplate}" SelectionMode="Single"
                      ContainerContentChanging="TrackList_ContainerContentChanging" DoubleTapped="TrackList_DoubleTapped"
                      IsItemClickEnabled="False" ShowsScrollingPlaceholders="False" Padding="0,0,0,16">
                <ListView.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="Play" Click="Ctx_Play"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE768;"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
                        <MenuFlyoutItem Text="Play next" Click="Ctx_PlayNext"/>
                        <MenuFlyoutItem Text="Add to queue" Click="Ctx_Enqueue"/>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem Text="Show in Explorer" Click="Ctx_Explorer"/>
                    </MenuFlyout>
                </ListView.ContextFlyout>
            </ListView>
            <GridView x:Name="GroupGrid" ItemTemplate="{StaticResource GroupTemplate}" Visibility="Collapsed" IsItemClickEnabled="True"
                      ItemClick="GroupGrid_ItemClick" SelectionMode="None" ContainerContentChanging="GroupGrid_ContainerContentChanging" Padding="0,0,0,16"/>
            <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Visibility="Collapsed">
                <FontIcon Glyph="&#xE8D6;" FontSize="48" Opacity="0.5"/>
                <TextBlock Text="Your library is empty" FontSize="20" HorizontalAlignment="Center"/>
                <TextBlock Text="Add a folder with music to get started." Opacity="0.7" HorizontalAlignment="Center"/>
                <Button Content="Add folder" Click="AddFolder_Click" HorizontalAlignment="Center" Style="{StaticResource AccentButtonStyle}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
