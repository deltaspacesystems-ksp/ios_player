<UserControl x:Class="Lumen.App.PlayerBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0" Padding="16,10,16,12">
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="200"/>
                <ColumnDefinition Width="2*" MinWidth="360"/>
                <ColumnDefinition Width="*" MinWidth="180"/>
            </Grid.ColumnDefinitions>

            <!-- track info -->
            <Button x:Name="InfoButton" Grid.Column="0" Padding="0" Background="Transparent" BorderThickness="0" Click="Info_Click"
                    HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Border Width="56" Height="56" CornerRadius="8" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                        <Image x:Name="ArtImage" Stretch="UniformToFill"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center" MaxWidth="260">
                        <TextBlock x:Name="TitleText" Text="Nothing playing" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="ArtistText" Opacity="0.7" FontSize="12" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </StackPanel>
            </Button>

            <!-- transport + seek -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6">
                    <ToggleButton x:Name="ShuffleBtn" Click="Shuffle_Click" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Shuffle">
                        <FontIcon Glyph="&#xE8B1;" FontSize="16"/>
                    </ToggleButton>
                    <Button Click="Prev_Click" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Previous">
                        <FontIcon Glyph="&#xE892;" FontSize="18"/>
                    </Button>
                    <Button x:Name="PlayBtn" Click="Play_Click" Width="44" Height="44" CornerRadius="22" Style="{StaticResource AccentButtonStyle}">
                        <FontIcon x:Name="PlayIcon" Glyph="&#xE768;" FontSize="18"/>
                    </Button>
                    <Button Click="Next_Click" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Next">
                        <FontIcon Glyph="&#xE893;" FontSize="18"/>
                    </Button>
                    <Button x:Name="RepeatBtn" Click="Repeat_Click" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Repeat">
                        <FontIcon x:Name="RepeatIcon" Glyph="&#xE8EE;" FontSize="16"/>
                    </Button>
                </StackPanel>
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="46"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PosText" Text="0:00" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" Opacity="0.7"/>
                    <Slider x:Name="SeekSlider" Grid.Column="1" Minimum="0" Maximum="1000" ThumbToolTipValueConverter="{x:Null}"
                            ValueChanged="Seek_ValueChanged" IsThumbToolTipEnabled="False"/>
                    <TextBlock x:Name="DurText" Grid.Column="2" Text="0:00" VerticalAlignment="Center" FontSize="12" Opacity="0.7"/>
                </Grid>
            </StackPanel>

            <!-- volume etc. -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="6">
                <Button x:Name="XfadeBadge" Background="Transparent" BorderThickness="0" Click="Xfade_Click" ToolTipService.ToolTip="Crossfade">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE9D9;" FontSize="14"/>
                        <TextBlock x:Name="XfadeText" FontSize="12"/>
                    </StackPanel>
                </Button>
                <Button x:Name="MuteBtn" Click="Mute_Click" Background="Transparent" BorderThickness="0">
                    <FontIcon x:Name="VolIcon" Glyph="&#xE767;" FontSize="16"/>
                </Button>
                <Slider x:Name="VolSlider" Width="110" Minimum="0" Maximum="100" ValueChanged="Vol_ValueChanged" IsThumbToolTipEnabled="False"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
