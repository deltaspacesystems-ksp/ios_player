<Page x:Class="Lumen.App.NowPlayingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:Lumen.App"
      NavigationCacheMode="Required">
    <Grid x:Name="Host" Background="#CC101014">
        <!-- soft blurred backdrop: a tiny decode scaled up looks blurred -->
        <Image x:Name="BgImage" Stretch="UniformToFill" Opacity="0.55"/>
        <Rectangle Fill="#99000000"/>

        <Grid Padding="40,20,40,16" ColumnSpacing="48">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="330"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center" Spacing="10" Width="360">
                <Border CornerRadius="18" Width="360" Height="360" Background="#33FFFFFF">
                    <Image x:Name="BigArt" Stretch="UniformToFill"/>
                </Border>
                <TextBlock x:Name="TitleText" FontSize="26" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis" Margin="0,8,0,0"/>
                <TextBlock x:Name="ArtistText" FontSize="18" Foreground="#D0FFFFFF" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="AlbumText" FontSize="14" Foreground="#99FFFFFF" TextTrimming="CharacterEllipsis"/>
                <local:SpectrumView x:Name="Viz" Height="64" Margin="0,8,0,0"/>
            </StackPanel>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <local:LyricsView x:Name="Lyr"/>
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6" Margin="0,8,0,0">
                    <TextBlock x:Name="SourceText" VerticalAlignment="Center" Foreground="#80FFFFFF" FontSize="12" Margin="0,0,10,0"/>
                    <TextBlock Text="Sync" VerticalAlignment="Center" Foreground="#B0FFFFFF" FontSize="12"/>
                    <Button Content="−0.5" Click="Off_Click" Tag="-0.5" Padding="8,2"/>
                    <Button Content="−0.1" Click="Off_Click" Tag="-0.1" Padding="8,2"/>
                    <TextBlock x:Name="OffText" Text="0.0 s" VerticalAlignment="Center" Foreground="White" Width="52" TextAlignment="Center"/>
                    <Button Content="+0.1" Click="Off_Click" Tag="0.1" Padding="8,2"/>
                    <Button Content="+0.5" Click="Off_Click" Tag="0.5" Padding="8,2"/>
                    <Button Content="Reset" Click="Off_Click" Tag="reset" Padding="8,2"/>
                    <Button Content="Import .lrc…" Click="Import_Click" Padding="8,2"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Page>
