<Page x:Class="Lumen.App.QueuePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:Lumen.App">
    <Grid Padding="28,12,28,0" RowSpacing="10">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Text="Queue" FontSize="30" FontWeight="SemiBold"/>
        <ListView x:Name="List" Grid.Row="1" IsItemClickEnabled="True" ItemClick="List_ItemClick" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:TrackVM">
                    <Grid Height="50" ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                        <Border Width="40" Height="40" CornerRadius="6" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                            <Image Source="{x:Bind Art, Mode=OneWay}" Stretch="UniformToFill"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{x:Bind Artist}" FontSize="12" Opacity="0.65" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{x:Bind DurationText}" VerticalAlignment="Center" HorizontalAlignment="Right" Opacity="0.65"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
